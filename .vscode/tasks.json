{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build core",
      "type": "shell",
      "command": "make -C core all build/test_filter build/test_pose build/test_gesture build/test_step build/test_trace build/replay",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test everything",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run (camera + HUD)",
      "type": "shell",
      "command": "make run",
      "problemMatcher": []
    },
    {
      "label": "record a trace",
      "type": "shell",
      "command": "make run ARGS=\"--record traces/${input:traceName}.csv\"",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "traceName",
      "type": "promptString",
      "description": "Trace name (saved as traces/<name>.csv), e.g. real_nose_scratch"
    }
  ]
}
